{
  "name": "MMM-TemperatureRadar",
  "version": "1.0.0",
  "description": "A MagicMirror module for displaying temperature readings in a radar chart",
  "main": "MMM-TemperatureRadar.js",
  "author": "Harshit Sanghvi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanghviharshit/MMM-TemperatureRadar.git"
  },
  "keywords": ["magicmirror", "magicmirror2", "temperature", "radar", "home-assistant", "chart"],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "overrides": {
    "glob": "13.0.6",
    "inflight": "npm:inflight-lru@^1.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "MMM-TemperatureRadar.js",
      "node_helper.js"
    ]
  }
}
